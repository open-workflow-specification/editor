{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest", "node", "vite/client"],

    // Tests can import JS or TS freely
    "allowJs": true,

    // Preserve JSX so test runner interprets it
    "jsx": "react-jsx",

    // No declaration output during tests
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rootDir": ".",

    // Tests often work with dynamic/loosely typed objects
    "exactOptionalPropertyTypes": false
  },
  "include": ["tests/**/*", "tests-e2e/**/*"]
}
